# Copy to .env and edit. .env is gitignored.

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-deploy-anything

DATABASE_URL=sqlite:///./vendor360.db

# Comma separated. Must be explicit origins, never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accept a fixed OTP and return the generated one in the API response.
# MUST be false in production.
DEBUG_OTP=true
DEBUG_OTP_CODE=123456
OTP_EXPIRE_MINUTES=10

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Enables the /api/demo/seed endpoint.
DEMO_MODE=true
