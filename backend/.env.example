# Copy to .env and edit. .env is gitignored.
#
# The defaults in config.py are the SAFE ones: DEBUG_OTP and DEMO_MODE are off
# unless you turn them on, and APP_ENV=production refuses to start if anything
# below is still set for convenience rather than safety.

# development | production
APP_ENV=development

# --- Required in production -------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset means a new key every restart, which signs everyone out on every deploy.
SECRET_KEY=change-me-before-you-deploy-anything

DATABASE_URL=sqlite:///./vendor360.db

# Comma separated, explicit origins, never "*". Production must be https://.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Sessions ---------------------------------------------------------------
# 12 hours. A token cannot be revoked individually; a password change or
# /api/auth/logout-all invalidates every token for that account at once.
ACCESS_TOKEN_EXPIRE_MINUTES=720
# How long the shopkeeper has to enter the code after their password.
CHALLENGE_TOKEN_EXPIRE_MINUTES=10

# --- OTP --------------------------------------------------------------------
# DEVELOPMENT ONLY. Accepts a fixed code for any account and returns the
# generated code in the API response. Startup refuses this in production.
DEBUG_OTP=false
DEBUG_OTP_CODE=123456
OTP_EXPIRE_MINUTES=10
# Wrong guesses before the code is destroyed and a fresh sign-in is required.
OTP_MAX_ATTEMPTS=5

# --- Delivery of codes and reset links --------------------------------------
# none | console | http.  "console" prints to the server log (development).
# "http" POSTs JSON to your SMS or email gateway -- MSG91, Twilio, Gupshup or an
# internal bridge. Placeholders {to} {code} {message} {link} are substituted.
# Production refuses anything but "http": without delivery nobody can sign in.
NOTIFY_PROVIDER=console
NOTIFY_HTTP_URL=
NOTIFY_HTTP_METHOD=POST
# Pipe-separated "Name: value" pairs, e.g.  Authorization: Bearer xxx|X-Key: yyy
NOTIFY_HTTP_HEADERS=
NOTIFY_HTTP_BODY={"to": "{to}", "message": "{message}"}
NOTIFY_TIMEOUT_SECONDS=8

# --- Password reset ----------------------------------------------------------
RESET_TOKEN_EXPIRE_MINUTES=30
# Where the emailed link points. Must be https in production.
PASSWORD_RESET_URL=http://localhost:5173/auth

# --- Stock -------------------------------------------------------------------
# Goods arriving within this many days are flagged at the confirm step.
SHORT_DATED_DAYS=30

# --- Rate limiting ----------------------------------------------------------
# In-process and per-instance. Running more than one worker means moving this
# to a shared store; see the note at the top of ratelimit.py.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600
OTP_RATE_LIMIT=15
OTP_RATE_WINDOW_SECONDS=300

# Largest accepted request body, in bytes.
MAX_REQUEST_BYTES=1048576

# --- Exposure ---------------------------------------------------------------
# The interactive docs publish every endpoint and schema. Off in production.
ENABLE_DOCS=true

# DEVELOPMENT ONLY. /api/demo/seed DELETES the caller's products, customers and
# sales before seeding samples. Startup refuses this in production.
DEMO_MODE=true
